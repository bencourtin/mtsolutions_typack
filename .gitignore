# ==============================================
# TYPACK ETL Project - GitIgnore Configuration
# ==============================================

# ===== ARCHIVOS DE CONFIGURACIÓN SENSIBLES =====
# Excluir archivos con credenciales y configuraciones específicas del entorno
config/config.json
config/credenciales.json
config/lineas.json

# ===== DIRECTORIOS DE DATOS =====
# Excluir todas las carpetas de datos para evitar subir datasets grandes
data/
data/*
data/raw/
data/processed/
data/external/
data/consolidated/

# ===== LOGS Y ARCHIVOS DE SEGUIMIENTO =====
# Excluir logs y archivos temporales
logs/
logs/*
*.log
*.log.*

# ===== ENTORNOS VIRTUALES DE PYTHON =====
.venv/
venv/
env/
.env
ENV/
env.bak/
venv.bak/

# ===== CACHE Y ARCHIVOS COMPILADOS DE PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===== JUPYTER NOTEBOOKS =====
*.ipynb
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ===== IDE Y EDITORES =====
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

