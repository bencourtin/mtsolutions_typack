# ===== CREDENCIALES API =====
API_USER=
API_PASS=

# ===== OPERACIÓN DEL EXTRACTOR =====
# El corte del día operativo (08:00 locales) y el desfase del reloj del
# proveedor NO se configuran: dependen de la fecha del dato y los calcula
# `date_utils`. No vuelva a agregar CORTE_OPERATIVO_UTC ni OFFSET_PLANTA_HORAS.
# Días operativos hacia atrás que re-extrae el ETL diario (30 + holgura).
EXTRACTOR_WINDOW_DAYS=35
# Días que se conservan las bitácoras plan_/results_ (el libro de auditoría no se rota).
RETENCION_LOGS_DIAS=90
# Días que se conserva la respuesta cruda de la API (el manifiesto no se rota).
RETENCION_SNAPSHOTS_DIAS=90
# Líneas que pueden fallar antes de que el ETL aborte la transformación.
ETL_MAX_LINEAS_FALLIDAS=2

# ===== SMTP / EMAIL =====
SMTP_SERVER=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

EMAIL_SENDER_NAME=MT Typack Sabana ETL
EMAIL_ENABLED=true
# Decorativa: el día del reporte lo decide el disparador de la tarea programada
# (deploy/ETL_Typack_Semanal.xml), no esta variable.
EMAIL_WEEKLY_REPORT_DAY=1

# Destinatarios separados por coma
EMAIL_RECIPIENTS_ERROR=
EMAIL_RECIPIENTS_WEEKLY=

# ===== RUTAS DE DATOS =====
# EN EL SERVIDOR: usar las rutas LOCALES de Google Drive en modo "Reflejar",
# no la unidad G:. Drive monta G: por sesión de usuario, así que una tarea
# programada que corre sin sesión iniciada no la ve y el ETL falla sin datos.
# Las ocho rutas tienen que estar definidas: las que falten caen a un default
# relativo al repo, y ahí el estado del CDC queda fuera de Drive y se pierde
# en el próximo clone.
PATH_RAW=data/raw
PATH_PROCESSED=data/processed
PATH_CONSOLIDATED=data/consolidated
PATH_STREAM_DATA=data/stream_data
PATH_LOGS=logs
# Landing inmutable: respuestas crudas de la API y manifiesto de corridas.
PATH_SNAPSHOTS=data/snapshots
# Libro de auditoría de reasignaciones y cobertura diaria.
PATH_AUDIT=data/audit
